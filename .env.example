# Copy this file to .env.local for local development, and set the same
# values in your Vercel project's Environment Variables for production.

# Auto-created when you connect a Vercel Blob store to this project
# (Vercel dashboard -> Storage -> Create Database -> Blob -> Connect to Project).
# Run `vercel env pull .env.local` to bring it into your local project.
BLOB_READ_WRITE_TOKEN=

# The PIN you'll type at /seller to log in. Login attempts are slowed down,
# but a short numeric PIN (e.g. 4 digits) is still guessable over time.
# Use at least 6-8 characters, ideally mixing in a letter — e.g. Gadwal47x
SELLER_PIN=

# A random secret used to sign the seller login session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SELLER_SECRET=
